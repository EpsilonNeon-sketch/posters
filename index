<!DOCTYPE html>
<html>
  <head>
    <title>posters</title>
 
  </head>
  <style>
    * {
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  margin: 0;
  padding: 64px 24px;
  background: linear-gradient(135deg, #eef2ff, #f8fafc 55%, #e0f2fe);
  color: #172033;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

body > h1,
body > a {
  display: block;
  width: min(100%, 720px);
  margin-right: auto;
  margin-left: auto;
}

body > h1 {
  margin-top: 0;
  margin-bottom: 16px;
  padding: 28px 30px 0;
  font-size: clamp(1.35rem, 4vw, 2rem);
  line-height: 1.3;
  letter-spacing: -0.03em;
}

body > a {
  margin-bottom: 28px;
  padding: 0 30px 26px;
  color: #fff;
  font-size: 0.95rem;
  font-weight: 700;
  text-decoration: none;
}

body > h1:first-of-type {
  margin-top: 0;
  padding-top: 30px;
  border-radius: 18px 18px 0 0;
  background: #fff;
  box-shadow: 0 12px 35px rgb(32 51 90 / 10%);
}

body > h1:first-of-type + a {
  padding-top: 4px;
  border-radius: 0 0 18px 18px;
  background: #fff;
  color: #4f46e5;
  box-shadow: 0 12px 35px rgb(32 51 90 / 10%);
}

body > h1:nth-of-type(2) {
  margin-top: 32px;
  padding-top: 30px;
  border-radius: 18px 18px 0 0;
  background: #fff;
  box-shadow: 0 12px 35px rgb(32 51 90 / 10%);
}

body > h1:nth-of-type(2) + a {
  padding-top: 4px;
  border-radius: 0 0 18px 18px;
  background: #fff;
  color: #4f46e5;
  box-shadow: 0 12px 35px rgb(32 51 90 / 10%);
}

body > a:hover {
  color: #3730a3;
  text-decoration: underline;
}

body > a:focus-visible {
  outline: 3px solid #818cf8;
  outline-offset: 4px;
}

@media (max-width: 480px) {
  body {
    padding: 36px 16px;
  }

  body > h1 {
    padding-right: 22px;
    padding-left: 22px;
  }

  body > a {
    padding-right: 22px;
    padding-left: 22px;
  }
}

  </style>
  <body>
     <h1>Epsilon learn and azure (to be printed on one paper each side a page)</h1>
     <a href="https://canva.link/9t8pkrsd7z6d927">veiw</a>
     <h1>Campaign poster</h1>
     <a href="https://canva.link/9kfw2i4g5qg9afp">veiw</a>
  </body>
</html>
